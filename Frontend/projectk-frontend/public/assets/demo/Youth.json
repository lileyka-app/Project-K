,"canScore":true,"entries":[{"scoreEntryKey":"b540d877-5dbe-4a70-8eb6-515d98fe027f","membershipKey":"0c828285-9e2a-415e-a952-7ea166289df5","memberKey":"8139161b-d22a-458d-88c0-bcb615f0de4f","memberName":"Ростислав Марчук","groupKey":"6523bd3f-4150-4e3f-b0a0-2a76cb6e66ba","groupName":"Соколи","isForGroup":false,"scoreItemKey":"db01a2f1-97b3-4c3a-9a6a-7c7008fe2b51","itemName":"Однострій","points":1,"reason":null,"agendaItemKey":"0f6d5ec0-534d-49f8-b30a-d9f123d45d2d","occurrenceStartUtc":"2026-10-07T14:00:00Z","occurredOn":"2026-10-07","createdByName":"Данило Яремчук","createdAtUtc":"2026-10-07T16:00:00Z"}]}],"groups":[{"groupKey":"d276f3d5-0a16-43e5-8a08-54280abd25d5","groupName":"Ведмеді","canScore":false,"entries":[]},{"groupKey":"2a28c3ff-761e-4c1d-963f-d4d18c70ba03","groupName":"Леви","canScore":false,"entries":[]},{"groupKey":"6523bd3f-4150-4e3f-b0a0-2a76cb6e66ba","groupName":"Соколи","canScore":true,"entries":[]}],"items":[{"scoreItemKey":"6f006507-9465-4bb2-a1f0-ed11d492dbfa","name":"Без однострою","points":-2,"isArchived":false},{"scoreItemKey":"e380a033-996a-4fcc-b662-570fa42e9cf7","name":"Запізнення","points":-1,"isArchived":false},{"scoreItemKey":"6baf13ec-b31e-446e-8dde-3722d6e78066","name":"Нотатник","points":1,"isArchived":false},{"scoreItemKey":"db01a2f1-97b3-4c3a-9a6a-7c7008fe2b51","name":"Однострій","points":1,"isArchived":false}],"canManage":false}},{"m":"GET","p":"/api/catalog/probes/probe-1/grouped","s":200,"b":{"id":"probe-1","title":"Перша проба (Скобине крило)","pointsCount":55,"sectionsCount":8,"sections":[{"id":"probe-1-section-a","code":"А","title":"Три головні обов’язки пластуна","points":[{"id":"probe-1-section-a-point-1","title":"Знає на пам’ять і пояснить Три Головні Обов’язки Пластуна."},{"id":"probe-1-section-a-point-2","title":"Відбуває релігійну практику в своєму обряді."},{"id":"probe-1-section-a-point-3","title":"Знає на пам’ять і пояснить 14 точок Пластового Закону."},{"id":"probe-1-section-a-point-4","title":"Знає і дотримується правил поводження з національними символами України. Заспіває Національний Гімн України, намалює Герб України, знає як виглядає національний прапор. Розповість їх історію."},{"id":"probe-1-section-a-point-5","title":"Щоденно спілкується українською мовою та дбає про чистоту свого мовлення. Налаштує українську мову в своїх електронних пристроях та програмах, якими користується."},{"id":"probe-1-section-a-point-6","title":"Пояснить пластове розуміння доброго діла та як практикує його в щоденному житті. Зробить добре діло з гуртком."},{"id":"probe-1-section-a-point-7","title":"Знає головні географічні характеристики України (площа, населення, області, інше), головні події з новітньої історії України (Перші та другі визвольні змагання, дисидентський рух, відновлення незалежності, Майдани) та сучасного провідника Української держави."},{"id":"probe-1-section-a-point-8","title":"Знає історію і сучасність свого міста чи села."},{"id":"probe-1-section-a-point-9","title":"Знає про поселення українців поза межами України. Виконає проєкт «Пласт та українці у світі» світі» (наприклад, доповнить чи виправить відповідну статтю у Вікіпедії)."},{"id":"probe-1-section-a-point-10","title":"Добре навчається в школі та підтвердить це відповідним документом."},{"id":"probe-1-section-a-point-11","title":"На сходинах гуртка розповість про останню прочитану книгу позашкільної програми."}]},{"id":"probe-1-section-b","code":"Б","title":"Пластова ідея","points":[{"id":"probe-1-section-b-point-1","title":"Знає хто, коли і для чого заснував скаутський рух (Бейден Поуел) та Пласт (Іван Чмола, Петро Франко, Олександр Тисовський)."},{"id":"probe-1-section-b-point-2","title":"Заспіває і пояснить Пластовий Обіт. Знає його авторів."},{"id":"probe-1-section-b-point-3","title":"Пояснить пластове гасло СКОБ та його символи."},{"id":"probe-1-section-b-point-4","title":"Знає та заспіває Пластовий Гімн та Гімн Закарпатських Пластунів, знає їх авторів."},{"id":"probe-1-section-b-point-5","title":"Намалює і пояснить пластову відзнаку, знає де її можна і треба носити та зображати. Знайомий із основними правилами бренд-буку Пласту."},{"id":"probe-1-section-b-point-6","title":"Знає хто і чому є патроном Пласту. Знає життєпис патрона Пласту."},{"id":"probe-1-section-b-point-7","title":"Знає життєпис патрона свого куреня та прикмети характеру, що зробили його гідним наслідування."}]},{"id":"probe-1-section-v","code":"В","title":"Пластова організація","points":[{"id":"probe-1-section-v-point-1","title":"Знає та пояснить організацію гуртка, права та обов’язки членів гуртка, гурткових діловодів та їх відзнаки. Успішно виконує своє гурткове діловодство."},{"id":"probe-1-section-v-point-2","title":"Знає організацію куреня та пояснить обов’язки діловодів. Знає відзнаки курінних діловодів, хто є в проводі куреня. Може швидко із ними сконтактувати."},{"id":"probe-1-section-v-point-3","title":"Знає, хто є станичним/-ою і структуру станичного проводу. Знає, які відзнаки носять ці діловоди."},{"id":"probe-1-section-v-point-4","title":"Знає, які відзначення і перестороги надаються в Пласті. Знає відзнаки пластових відзначень."}]},{"id":"probe-1-section-g","code":"Г","title":"Пластові заняття","points":[{"id":"probe-1-section-g-point-1","title":"Знає і заспіває не менше, ніж 4 народні та 4 пластові пісні, пояснить їх походження."},{"id":"probe-1-section-g-point-2","title":"Вміє надавати й виконувати впорядові накази в гуртку."},{"id":"probe-1-section-g-point-3","title":"Знає правила чесної гри і їх дотримується. Пояснить і проведе 3 гри з гуртком чи куренем. Пояснить їх призначення та користь."},{"id":"probe-1-section-g-point-4","title":"Читає пластові публікації та зробить допис на пластову тематику."},{"id":"probe-1-section-g-point-5","title":"Візьме участь у 3-х пластових заходах (спільному занятті з іншим гуртком, тереновій грі, спортивному змазі, інтелектуальному, мистецькому, майстерці чи іншому заході)."},{"id":"probe-1-section-g-point-6","title":"Знає, які є види прогулянок (екскурсій) і візьме участь в одній з них зі своїм гуртком."}]},{"id":"probe-1-section-ghe","code":"Ґ","title":"Життя в природі","points":[{"id":"probe-1-section-ghe-point-1","title":"Знає, чому треба дбати про довкілля і пояснить, як це сам робить."},{"id":"probe-1-section-ghe-point-2","title":"Знає по 10 рослин і 10 тварин своєї околиці, небезпечні і корисні рослини і тварини, розпізнає сліди не менше 6 тварин."},{"id":"probe-1-section-ghe-point-3","title":"Вміє збудувати гніздо для розпалення вогню; запалить його не більше, як трьома сірниками; правильно загасить і затре слід від вогню."},{"id":"probe-1-section-ghe-point-4","title":"Знає, який особистий виряд потрібен на одноденну прогульку і спакує наплечник."},{"id":"probe-1-section-ghe-point-5","title":"Знає, який особистий виряд потрібен на табір і спакує наплечник."},{"id":"probe-1-section-ghe-point-6","title":"Зав’яже 6 вузлів та одне в’язання, знає, коли їх застосовувати. Візьме участь у побудові піонірської споруди. Знає правила відповідальної піонірки."},{"id":"probe-1-section-ghe-point-7","title":"Знає, як правильно користуватись, зберігати та транспортувати ніж, сокиру, лопату, пилу."},{"id":"probe-1-section-ghe-point-8","title":"Вміє вибрати місце під шатро, розставити його та спакувати, затерти сліди свого перебування згідно з правилами екологічного таборування."},{"id":"probe-1-section-ghe-point-9","title":"Відбуде одну гурткову чи курінну мандрівку в природі з нічлігом."},{"id":"probe-1-section-ghe-point-10","title":"Відбуде один курінний або окружний виховний табір за програмою першої проби."}]},{"id":"probe-1-section-d","code":"Д","title":"Життєва зарадність","points":[{"id":"probe-1-section-d-point-1","title":"Вміє викликати лікаря, поліцію, пожежну охорону (рятувальників), газову службу. Може швидко дізнатись графік руху потрібного транспорту."},{"id":"probe-1-section-d-point-2","title":"Вміє надати допомогу у випадках: поранення, сонячного удару, опіку чи переохолодження/обмороження."},{"id":"probe-1-section-d-point-3","title":"Покаже сторони світу за допомогою компаса, сонця та зір. Вміє зорієнтувати карту на місцевості."},{"id":"probe-1-section-d-point-4","title":"Знає основні знаки на топографічній карті. Зайде у визначене на цій карті місце. Вміє користуватися сучасними способами навігації у місті та електронними картами."},{"id":"probe-1-section-d-point-5","title":"Вміє правильно користуватися різними засобами обміну інформацією: пошта (звичайна та електронна), Інтернет, телефон."},{"id":"probe-1-section-d-point-6","title":"Знає правила доброї поведінки та дотримується їх в житті. Візьме участь у гутірці про добру поведінку."},{"id":"probe-1-section-d-point-7","title":"Знає правила дорожнього руху для пішохода та велосипедиста."},{"id":"probe-1-section-d-point-8","title":"Володіє іноземною мовою на доступному рівні (щонайменше А2 за глобальною шкалою), щоб пояснити особисті потреби, відрекомендуватися та відповісти на запитання про себе чи інших людей. Візьме участь у діалозі на довільну тему іноземною мовою."},{"id":"probe-1-section-d-point-9","title":"Знає правила ведення дискусії. Візьме участь у дискусії на довільну тему."},{"id":"probe-1-section-d-point-10","title":"Знає і практикує принципи інформаційної безпеки в Інтернеті."},{"id":"probe-1-section-d-point-11","title":"Знає засади правильної організації власного часу та практикує їх в щоденному житті."}]},{"id":"probe-1-section-e","code":"Е","title":"Тіловиховання","points":[{"id":"probe-1-section-e-point-1","title":"Знає основні вправи щоденної руханки та практикує її щодня. Регулярно, принаймні двічі на тиждень, відвідує спортивну секцію або займається рухливими іграми/спортом."},{"id":"probe-1-section-e-point-2","title":"Вміє плавати та пропливе будь-яким стилем 50 метрів."},{"id":"probe-1-section-e-point-3","title":"Здобуде ВФВ свого віку (за бажанням)."}]},{"id":"probe-1-section-ye","code":"Є","title":"Юнацькі вмілості","points":[{"id":"probe-1-section-ye-point-1","title":"Знає, де знайти перелік пластових вмілостей, як їх осягати та де пришивати здобуті."},{"id":"probe-1-section-ye-point-2","title":"Здобуде пластову вмілість «Перша допомога І»."},{"id":"probe-1-section-ye-point-3","title":"Здобуде 5 пластових вмілостей Першої Проби (серед яких рекомендовано «Домашню зарадність І»)."}]}]}},{"m":"GET","p":"/api/member/edc4924e-499d-4a41-90bc-34f4a160a6b2","s":200,"b":{"memberKey":"edc4924e-499d-4a41-90bc-34f4a160a6b2","publicId":null,"groupKey":"00000000-0000-0000-0000-000000000000","groupName":null,"kurinKey":"2e00271a-07dd-4099-ba51-245e44797e81","isStaff":false,"mentoredGroupNames":[],"mentoredGroups":[],"userKey":"f74a7ba1-83ac-4372-5bd8-08df2cffc65c","accountStatus":null,"invitationSent":null,"userRole":null,"firstName":"Ярослав","middleName":"Орестович","lastName":"Гнатюк","email":"demo29@projectk.com","phoneNumber":"+380994624846","dateOfBirth":"1990-10-21","address":"","school":"","motherFirstName":"","motherLastName":"","motherPhone":"","fatherFirstName":"","fatherLastName":"","fatherPhone":"","cardExtras":{},"latestPlastLevel":"Senior","plastLevelHistories":[{"memberKey":"edc4924e-499d-4a41-90bc-34f4a160a6b2","plastLevelHistoryKey":"d12a235d-2e60-4a8d-fa50-08df2cffc968","plastLevel":"Entry","dateAchieved":"2001-10-21"},{"memberKey":"edc4924e-499d-4a41-90bc-34f4a160a6b2","plastLevelHistoryKey":"bec2544f-c4ba-4a15-fa51-08df2cffc968","plastLevel":"Uchasnyk","dateAchieved":"2002-10-21"},{"memberKey":"edc4924e-499d-4a41-90bc-34f4a160a6b2","plastLevelHistoryKey":"239bb512-2c38-4d23-fa52-08df2cffc968","plastLevel":"Rozviduvach","dateAchieved":"2004-10-21"},{"memberKey":"edc4924e-499d-4a41-90bc-34f4a160a6b2","plastLevelHistoryKey":"a6d78c12-ccee-4cfa-fa53-08df2cffc968","plastLevel":"Skob","dateAchieved":"2006-10-21"},{"memberKey":"edc4924e-499d-4a41-90bc-34f4a160a6b2","plastLevelHistoryKey":"f0ca04ce-13c4-4c87-fa54-08df2cffc968","plastLevel":"Starshoplastun","dateAchieved":"2008-10-21"},{"memberKey":"edc4924e-499d-4a41-90bc-34f4a160a6b2","plastLevelHis