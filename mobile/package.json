{
  "name": "lileyka-mobile",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:dev": "ng build --configuration development",
    "android:live": "cap run android -l --host 10.0.2.2 --port 4200",
    "sync": "ng build && cap sync",
    "cap": "cap",
    "e2e": "npm run build:pwa && playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "build:pwa": "ng build --base-href /m/"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/angular": "^9.0.8",
    "@rdlabo/ionic-theme-ios26": "^9.4.2",
    "@rdlabo/ionic-theme-ios27": "^1.2.1",
    "ionicons": "^8.1.0",
    "libphonenumber-js": "^1.13.15",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "^8.3.5",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
