{
  "ReleaseInfo": {
    "Version": "v0.0.0-dev",
    "Codename": "LocalDevelopment"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.ApplicationInsights",
      "Serilog.Filters.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://local.in.applicationinsights.azure.com/;LiveEndpoint=https://local.livediagnostics.monitor.azure.com/",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },

  "AllowedHosts": "*",

  "KurinNumbers": {
    "MaxNumber": 200
  },

  "Krai": {
    "Default": "ua"
  },

  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpiresInMinutes": 0,
    "RefreshTokenExpiresInDays": 7
  },

  "Telemetry": {
    "Enabled": false,
    "Endpoint": "https://status.lileyka.app/v1/ping",
    "InitialDelayMinutes": 5,
    "IntervalHours": 24,
    "TimeoutSeconds": 15
  },
  "Catalog": {
    "BaseUrl": "https://catalog.lileyka.app",
    "Krai": "",
    "RefreshMinutes": 60,
    "TimeoutSeconds": 30,
    "SnapshotPath": "catalog-cache/catalog.json"
  },

  "Security": {
    "MfaTrustDays": 7
  },

  "SecurityPatch": {
    "EnableGeoBlocking": true,
    "BlockedCountries": [ "RU", "BY" ],
    "GeoCountryHeader": "CF-IPCountry"
  },

  "SecurityMonitoring": {
    "FailedLoginThreshold": 5,
    "FailedMfaThreshold": 5,
    "FailedLoginWindow": "00:10:00",
    "FailedMfaWindow": "00:10:00",
    "IpChangeWindow": "1.00:00:00"
  },

  "LoginThrottle": {
    "FailureLimit": 10,
    "Window": "00:15:00"
  },

  "RateLimitBypassKey": "",
  "LoadTestLoginKey": "",

  "EnvCorsOrigin": "",

  "Feedback": {
    "GitHub": {
      "Token": "",
      "Repository": "lileyka-app/Project-K",
      "Labels": "bug,from client"
    }
  },

  "Telegram": {
    "DevAlerts": {
      "Enabled": false,
      "BotToken": "",
      "ChatId": "",
      "BaseUrl": "https://api.telegram.org",
      "TimeoutSeconds": 10,
      "DisableNotification": false,
      "MinimumLevel": "Warning",
      "MaxMessageLength": 3500,
      "GroupWindowSeconds": 300
    }
  },

  "Email": {
    "Provider": "Mock",
    "ApiKey": "re_...",
    "FromEmail": "onboarding@resend.dev",
    "FromName": "Лілейка",
    "ReplyTo": "",
    "RedirectAllTo": "",
    "BaseUrl": "http://localhost:4200"
  }
}
