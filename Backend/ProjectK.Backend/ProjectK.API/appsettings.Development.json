{
  "ReleaseInfo": {
    "Version": "v0.0.0-dev",
    "Codename": "LocalDevelopment"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=projectK;Trusted_Connection=True;TrustServerCertificate=True;",
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "BlobStorage": {
    "ContainerName": "photos",
    "BlobPrefix": "photos",
    "PublicBaseUrl": "http://127.0.0.1:10000/devstoreaccount1/photos"
  },
  "OrphanCleanup": {
    "Enabled": true,
    "Interval": "06:00:00",
    "GracePeriod": "01:00:00",
    "MaxDeletesPerRun": 500,
    "DryRun": false,
    "JitterSeconds": 30
  },
  "RateLimiting": {
    "StrictAuth": { "PermitLimit": 50, "WindowMinutes": 5 },
    "AccountSecurity": { "PermitLimit": 100, "WindowMinutes": 5 }
  },
  "Jwt": {
    "Key": "local-env-jwt-key-11092025-EXTRACHARS",
    "Issuer": "ProjectK-Backend",
    "Audience": "ProjectK-Users",
    "ExpiresInMinutes": 10
  },
  "DebugMode": {
    "SecurePasswordOptions": true
  },
  "SecurityPatch": {},

  "EnvCorsOrigin": "http://localhost:4200",

  "Email": {
    "FromEmail": "projectk-system@mail.lileyka.app",
    "ApiKey": "re_api_key",
    "Provider": "Resend",
    "BaseUrl": "http://localhost:4200",
    "FromName": "ProjectK-Dev"
  }
}
