<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />

    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

    <add key="github" value="https://nuget.pkg.github.com/lileyka-app/index.json" />
    <!-- Versions published before the repos moved to the org stay here. -->
    <add key="github-legacy" value="https://nuget.pkg.github.com/iamavasya/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <github>
      <add key="Username" value="iamavasya" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github>
    <github-legacy>
      <add key="Username" value="iamavasya" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github-legacy>
  </packageSourceCredentials>
</configuration>
