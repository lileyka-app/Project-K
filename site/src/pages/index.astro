---
/*
 * Вітальна сторінка сайту. Не Starlight: довідці потрібен її каркас, показу продукту — свій ритм,
 * і splash-шаблон не дає ні липкого кадру, ні власної сітки. Starlight лишається на /user/** і
 * /dev/**; сюди він не заходить, тому шапку, підвал і перемикач теми сторінка тримає сама.
 *
 * Рух — за BRANDBOOK §4.1: кадром керує прокрутка, стани міняються за 200ms, з руху лише opacity
 * і зсув по одній осі. Стовпчик написано першим, липкість накладена зверху — тому там, де
 * animation-timeline немає або людина просила менше руху, сторінка лишається читною сама собою.
 *
 * Кадри беруться з тих самих знімків, що й довідка (sync-docs.mjs кладе docs/user у
 * src/content/docs/user), тож показ не розходиться з тим, що людина потім побачить у довідці.
 */
import { Image } from 'astro:assets';
import '../styles/brand.css';

// Два файли знака, не один перефарбований: у темної версії власні кольори (BRANDBOOK §1), і
// підмінити їх через currentColor не можна — центральна пелюстка там світліша за решту.
import mark from '../assets/lileyka-mark.svg';
import markDark from '../assets/lileyka-mark-dark.svg';
import shotImport from '../content/docs/user/images/import.png';
import shotRegistry from '../content/docs/user/images/registry.png';
import shotMember from '../content/docs/user/images/member-card.png';
import shotProbe from '../content/docs/user/images/probe.png';
import shotCalendar from '../content/docs/user/images/calendar.png';

const title = 'Лілейка — система для куреня';
const description =
	'Реєстр, проби й вмілості, календар, вкладка й точкування в одному місці. Зроблено для куренів НСОУ «Пласт».';

// П'ять станів одного кадру — день, за який курінь опиняється в системі. Порядок не випадковий:
// кожен наступний можливий лише тому, що стався попередній.
const acts = [
	{
		shot: shotImport,
		alt: 'Імпорт складу: таблиця куреня, зіставлення колонок і попередній перегляд',
		step: 'Крок 1',
		title: 'Склад уже є — у таблиці',
		body: 'Курені ведуть склад у тому, що мають: Excel зі своїми колонками, часто у трьох версіях. Лілейка читає цю таблицю як є — формат вигадувати не треба.',
	},
	{
		shot: shotRegistry,
		alt: 'Реєстр куреня: юнаки, гуртки, ступені, пошук і вивантаження',
		step: 'Крок 2',
		title: 'За кілька хвилин — реєстр',
		body: 'Перед записом видно, що саме станеться: скільки людей нових, скільки вже в курені, кому піде лист. Нічого не записується, поки не підтвердиш.',
	},
	{
		shot: shotMember,
		alt: 'Картка людини: ступені, відзначення, гурток і членство',
		step: 'Крок 3',
		title: 'У кожного — своя картка',
		body: 'Історія належить людині, а не куреню: вийшла з куреня — проби, вмілості й ступені лишаються з нею. Курінь бачить ту частину шляху, що пройдена в ньому.',
	},
	{
		shot: shotProbe,
		alt: 'Проба: розділи, точки вимог і підписані точки',
		step: 'Крок 4',
		title: 'Проба завжди під рукою',
		body: 'Вимоги проб і вмілостей зібрані в одному місці. Впорядник підписує точку, юнак одразу бачить свій прогрес.',
	},
	{
		shot: shotCalendar,
		alt: 'Календар куреня: сходини, табори й задачі з відгуками',
		step: 'Крок 5',
		title: 'І все це має дату',
		body: 'Сходини, табори й задачі в одному календарі — з повторами, для всього куреня чи окремого гуртка, і з відповідями, хто прийде.',
	},
];

const audience = [
	{ who: 'Юнаку', what: 'Своя картка: проба, вмілості, відзначення, вкладка й точкування. Видно, що вже здобуто і куди рухатися далі.' },
	{ who: 'Впоряднику', what: 'Гурток під рукою: підписати точку проби, відмітити присутність на сходинах, побачити, хто відстає.' },
	{ who: 'Звʼязковому', what: 'Весь курінь: реєстр, провід, календар і планування. Що кому дозволено, визначає діловодство, а не окремі налаштування.' },
];

const inside = [
	{ name: 'Реєстр', what: 'Склад куреня з історією: гуртки, діловодства, ступені. Імпорт із наявної таблиці.' },
	{ name: 'Проби й вмілості', what: 'Цифрові проби, вмілості й відзначення. Підпис точок і прогрес кожного.' },
	{ name: 'Календар і планування', what: 'Сходини, табори й задачі з повторами та відповідями, хто прийде.' },
	{ name: 'Вкладка', what: 'Каса гуртка й куреня: ставки, внески, передачі до станиці, борг кожного юнака.' },
	{ name: 'Точкування', what: 'Присутність на сходинах, кастомні бали від суддів, гурткове і курінне точкування.' },
	{ name: 'Безпека', what: 'Двофакторний вхід для проводу, доступ за діловодством, можливість self-hosting на власний сервер.' },
];
---

<!doctype html>
<html lang="uk">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content="Лілейка" />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{/* Тема ставиться до першого малювання, інакше світла сторінка встигне блимнути перед темною.
		    Ключ той самий, що в Starlight, тож перехід у довідку не скидає вибір. */}
		<script is:inline>
			(() => {
				try {
					const saved = localStorage.getItem('starlight-theme');
					const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.dataset.theme = dark ? 'dark' : 'light';
				} catch {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
	</head>

	<body>
		<a class="skip" href="#tour">Перейти до показу</a>

		<header class="bar">
			<a class="bar__logo" href="/">
				<img class="lil-mark lil-mark--light" src={mark.src} alt="" width="28" height="28" />
				<img class="lil-mark lil-mark--dark" src={markDark.src} alt="" width="28" height="28" />
				<span>Лілейка</span>
			</a>
			<nav class="bar__nav">
				<a href="/user/start/what-is/">Довідка</a>
				<a href="/demo/">Демо</a>
				<a href="https://github.com/lileyka-app/Project-K" rel="noopener">GitHub</a>
				<button type="button" class="bar__theme" data-theme-toggle aria-label="Змінити тему">
					<span data-theme-label>Тема</span>
				</button>
			</nav>
		</header>

		<main>
			<section class="hero">
				{/* Лочап за §1: знак і слово поруч, горизонтально. Знак тут декоративний — слово
				    поруч читається вголос, тож alt порожній, інакше «Лілейка» прозвучить двічі. */}
				<h1 class="hero__lockup">
					<img class="lil-mark lil-mark--light" src={mark.src} alt="" />
					<img class="lil-mark lil-mark--dark" src={markDark.src} alt="" />
					<span>Лілейка</span>
				</h1>
				<p class="hero__lead">Весь курінь під рукою.</p>
				<p class="hero__sub">
					Реєстр, проби й вмілості, календар, вкладка й точкування — в одному місці.
					Зроблено для куренів НСОУ «Пласт».
				</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href="/demo/">Спробувати демо</a>
					<a class="btn" href="/user/start/what-is/">Як це працює</a>
				</div>
				<p class="hero__note">Демо відкривається без заявки й без пароля.</p>
			</section>

			<section class="tour" id="tour" aria-label="Перший день куреня в системі">
				<div class="tour__stage" aria-hidden="true">
					{acts.map((act, i) => (
						<figure class={`tour__shot tour__shot--${i + 1}`}>
							<Image src={act.shot} alt="" widths={[720, 1080, 1440]} sizes="(max-width: 960px) 92vw, 56vw" loading={i === 0 ? 'eager' : 'lazy'} />
						</figure>
					))}
				</div>

				<div class="tour__steps">
					{acts.map((act, i) => (
						<div class={`tour__step tour__step--${i + 1}`}>
							<div class="tour__copy">
								<p class="tour__kicker">{act.step}</p>
								<h2>{act.title}</h2>
								<p>{act.body}</p>
							</div>
							{/* Той самий кадр у потоці — його бачать там, де липкої сцени немає. */}
							<figure class="tour__inline">
								<Image src={act.shot} alt={act.alt} widths={[720, 1080]} sizes="92vw" loading="lazy" />
							</figure>
						</div>
					))}
				</div>
			</section>

			<section class="band">
				<p class="band__hand">А далі — як у курені заведено.</p>
				<p class="band__text">
					Лілейка не ламає того, як курінь уже працює, а підлаштовується під нього: провід і
					діловодства, проби й вмілості, сходини й табори, вкладка та точкування.
				</p>
			</section>

			<section class="cols" aria-labelledby="audience">
				<h2 id="audience">Для кого</h2>
				<div class="cols__grid">
					{audience.map((a) => (
						<article class="card">
							<h3>{a.who}</h3>
							<p>{a.what}</p>
						</article>
					))}
				</div>
			</section>

			<section class="cols" aria-labelledby="inside">
				<h2 id="inside">Що всередині</h2>
				<div class="cols__grid cols__grid--four">
					{inside.map((f) => (
						<article class="card">
							<h3>{f.name}</h3>
							<p>{f.what}</p>
						</article>
					))}
				</div>
			</section>

			<section class="start" aria-labelledby="start">
				<h2 id="start">Як почати</h2>
				<ol class="start__list">
					<li>Звʼязковий куреня подає заявку — Лілейка приймає курені, не окремих пластунів.</li>
					<li>Після схвалення приходить лист: обираєш пароль і одразу потрапляєш на свою головну.</li>
					<li>Далі — <a href="/user/start/first-login/">перший вхід</a>, <a href="/user/start/roles/">ролі та діловодства</a> і <a href="/user/roles/leader/">як завести курінь</a>.</li>
				</ol>
				<div class="hero__actions">
					<a class="btn btn--primary" href="/demo/">Спробувати демо</a>
					<a class="btn" href="/user/start/what-is/">Читати довідку</a>
				</div>
			</section>
		</main>

		<footer class="foot">
			<p>
				<a href="/user/about/">Про Лілейку</a> · <a href="/user/privacy/">Політика конфіденційності</a> ·
				<a href="/dev/self-host/">Власний сервер</a> ·
				<a href="https://github.com/lileyka-app/Project-K" rel="noopener">GitHub</a>
			</p>
			<p class="foot__fine">Лілейка — незалежний проєкт. Не є офіційним продуктом НСОУ «Пласт».</p>
		</footer>

		<script is:inline>
			(() => {
				const button = document.querySelector('[data-theme-toggle]');
				const label = document.querySelector('[data-theme-label]');
				if (!button || !label) return;

				const paint = () => {
					label.textContent = document.documentElement.dataset.theme === 'dark' ? 'Світла' : 'Темна';
				};

				button.addEventListener('click', () => {
					const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
					document.documentElement.dataset.theme = next;
					try {
						localStorage.setItem('starlight-theme', next);
					} catch {
						// Приватне вікно — тема діє до перезавантаження, і цього досить.
					}
					paint();
				});

				paint();
			})();
		</script>
	</body>
</html>

<style>
	/* ── Основа ────────────────────────────────────────────────────────────────
	   Кольори беруться з brand.css: там уже лежать обидві теми за тими самими
	   токенами, що в застосунку, тож тут нових кольорів не зʼявляється. */
	:root {
		--lil-ink: var(--sl-color-white);
		--lil-soft: var(--sl-color-gray-1);
		--lil-muted: var(--sl-color-gray-2);
		--lil-line: var(--sl-color-gray-5);
		--lil-surface: var(--sl-color-gray-6);
		--lil-paper: var(--sl-color-black);
		--lil-primary: var(--sl-color-accent);
		--lil-wide: min(100% - 2.5rem, 72rem);
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--lil-paper);
		color: var(--lil-ink);
		font-family: var(--sl-font);
		font-size: 1rem;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3 {
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	h2 {
		font-size: clamp(1.6rem, 3.4vw, 2.2rem);
		font-weight: 800;
		margin: 0 0 1.5rem;
	}

	a {
		color: var(--lil-primary);
	}

	.skip {
		position: absolute;
		left: -999px;
	}

	.skip:focus {
		left: 1rem;
		top: 1rem;
		z-index: 10;
		background: var(--lil-paper);
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--lil-line);
		border-radius: 8px;
	}

	.bar {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: var(--lil-wide);
		margin-inline: auto;
		padding: 0.875rem 0;
		background: color-mix(in srgb, var(--lil-paper) 88%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--lil-line);
	}

	.bar__logo {
		display: flex;
		align-items: center;
		/* Той самий відступ, що в герої: 0.4× висоти знака (§1), знак тут 28px. */
		gap: calc(28px * 0.4);
		color: var(--lil-ink);
		text-decoration: none;
	}

	.bar__logo span {
		font-family: var(--lil-font-hand);
		font-size: 1.4rem;
	}

	.bar__nav {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		font-size: 0.925rem;
	}

	.bar__nav a {
		color: var(--lil-soft);
		text-decoration: none;
		transition: color 200ms ease;
	}

	.bar__nav a:hover {
		color: var(--lil-primary);
	}

	.bar__theme {
		font: inherit;
		font-size: 0.875rem;
		color: var(--lil-soft);
		background: none;
		border: 1px solid var(--lil-line);
		border-radius: 8px;
		padding: 0.3rem 0.7rem;
		cursor: pointer;
		transition: border-color 200ms ease, color 200ms ease;
	}

	.bar__theme:hover {
		border-color: var(--lil-primary);
		color: var(--lil-primary);
	}

	@media (max-width: 620px) {
		.bar__nav a[href*='github'] {
			display: none;
		}
	}

	.hero {
		width: var(--lil-wide);
		margin: clamp(3.5rem, 9vw, 6.5rem) auto clamp(3rem, 7vw, 5rem);
		text-align: center;
	}

	.hero h1 {
		font-family: var(--lil-font-hand);
		font-weight: 400;
		font-size: clamp(3.25rem, 8vw, 5rem);
		line-height: 1.05;
		margin: 0 0 0.75rem;
	}

	/* Лочап (§1): знак і слово горизонтально, відступ між ними — 0.4× висоти знака. Вертикального
	   варіанта немає, тож на вузьких екранах лочап не ламається на два рядки, а меншає цілком. */
	.hero__lockup {
		--mark: clamp(3.5rem, 8.8vw, 5.5rem);
		--lockup-gap: calc(var(--mark) * 0.4);
		/* Слово стоїть праворуч від знака, тож лочап, відцентрований як ціле, лишає саме слово
		   правіше за центр сторінки — а весь текст під ним центрований по ній. Зсуваємо лочап
		   ліворуч на половину того, що займає знак із відступом: центр слова сходиться з центром
		   решти героя, знак звисає ліворуч. Менший множник — менший звис, 0 повертає як було. */
		--lockup-shift: calc((var(--mark) + var(--lockup-gap)) / 2);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--lockup-gap);
		/* Вільне поле навколо знака — висота нижнього вістря, ≈20% (§1). */
		padding-block: calc(var(--mark) * 0.1);
		translate: calc(var(--lockup-shift) * -1) 0;
	}

	.hero__lockup .lil-mark {
		flex: none;
		width: var(--mark);
		height: var(--mark);
	}

	/* Знак має два файли, а не один перефарбований: тема ставиться на <html> до першого малювання,
	   тож підміна тут не блимає. */
	.lil-mark--dark {
		display: none;
	}

	:root[data-theme='dark'] .lil-mark--light {
		display: none;
	}

	:root[data-theme='dark'] .lil-mark--dark {
		display: initial;
	}

	.hero__lead {
		font-size: clamp(1.4rem, 3.6vw, 2rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		margin: 0 0 1rem;
	}

	.hero__sub {
		max-width: 34rem;
		margin: 0 auto 2rem;
		color: var(--lil-muted);
		font-size: 1.075rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}

	.hero__note {
		margin: 1.25rem 0 0;
		color: var(--lil-muted);
		font-size: 0.9rem;
	}

	.btn {
		display: inline-block;
		padding: 0.7rem 1.4rem;
		border: 1px solid var(--lil-line);
		border-radius: 8px;
		color: var(--lil-ink);
		text-decoration: none;
		font-weight: 600;
		transition: background-color 200ms ease, border-color 200ms ease;
	}

	.btn:hover {
		background: var(--lil-surface);
		border-color: var(--lil-primary);
	}

	.btn--primary {
		background: var(--lil-primary);
		border-color: var(--lil-primary);
		color: var(--lil-paper);
	}

	.btn--primary:hover {
		background: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent-high);
		color: var(--lil-paper);
	}

	/* ── Тур ────────────────────────────────────────────────────────────────
	   Стовпчик пишеться першим і працює сам: кожен крок — текст плюс кадр під
	   ним. Липка сцена вмикається нижче, і тільки там, де браузер її вміє.   */
	.tour {
